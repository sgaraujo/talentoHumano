rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Bulletins: lectura pública (link compartible), escritura solo autenticados
    match /bulletins/{bulletinId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Registro de vistas: cualquiera puede escribir (tracking), solo auth puede leer
      match /views/{viewId} {
        allow create: if true;
        allow read: if request.auth != null;
      }
    }

    // Todas las demás colecciones: acceso solo para usuarios autenticados
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
